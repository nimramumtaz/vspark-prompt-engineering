# Copy this file to ".env" (optional) or set the variables in your shell.
# The server runs fine without a .env file — these are overrides.

PORT=3000

# Seed credentials for the first admin account (used only on a fresh database).
ADMIN_EMAIL=admin@vspark.pk
ADMIN_PASSWORD=Vspark@2026
ADMIN_NAME=VSPARK Admin

# Secret used to sign session tokens. If empty, one is generated once and
# stored in data/session-secret.txt.
SESSION_SECRET=

# Production storage. When set, registrations are stored in PostgreSQL
# (a single JSONB document) instead of data/db.json.
# DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require

# Optional: alternate local data directory (useful for tests).
# DATA_DIR=./data
